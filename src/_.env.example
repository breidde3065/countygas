# Copy to server/.env (locally) or set these as environment variables on your host.
ADMIN_PASSWORD=change-this-password
# Optional: any long random string; keeps admin sessions valid if you change the password
# SESSION_SECRET=
# PORT=3001
# On a host, point this at the persistent disk so orders and photos survive restarts, e.g. /var/data
# DATA_DIR=
# Set NODE_ENV=production on the host (turns on secure cookies and HSTS)
# NODE_ENV=production
